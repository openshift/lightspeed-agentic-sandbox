# Default cheap models for E2E (override via host env before running make e2e).
# Sourced by scripts/e2e-containers.sh; existing environment wins.

ANTHROPIC_MODEL=${ANTHROPIC_MODEL:-claude-haiku-4-5}
# Bedrock InvokeModel IDs (not Anthropic API shorthand). Global CRIS profile for Haiku 4.5.
ANTHROPIC_BEDROCK_MODEL=${ANTHROPIC_BEDROCK_MODEL:-global.anthropic.claude-haiku-4-5-20251001-v1:0}
GEMINI_MODEL=${GEMINI_MODEL:-gemini-2.5-pro}
OPENAI_MODEL=${OPENAI_MODEL:-gpt-6-luna}
# Azure model value is an Azure OpenAI deployment name; no safe cross-tenant default.
AZURE_OPENAI_MODEL=${AZURE_OPENAI_MODEL:-}
